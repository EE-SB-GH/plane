{
  "name": "@plane/editor",
  "version": "1.5.0",
  "private": true,
  "description": "Core Editor that powers Plane",
  "keywords": [
    "editor",
    "markdown",
    "nextjs",
    "react",
    "rich-text"
  ],
  "license": "AGPL-3.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./lib": "./dist/lib.js",
    "./server": "./dist/server.js",
    "./package.json": "./package.json",
    "./styles.css": "./dist/styles/index.css",
    "./styles": "./dist/styles/index.css"
  },
  "scripts": {
    "build": "tsc && tsdown",
    "dev": "tsdown --watch --no-clean",
    "check:lint": "oxlint --max-warnings=416 .",
    "check:types": "tsc --noEmit",
    "check:format": "oxfmt --check .",
    "test": "vitest run",
    "fix:lint": "oxlint --fix .",
    "fix:format": "oxfmt .",
    "clean": "rm -rf .turbo && rm -rf .next && rm -rf node_modules && rm -rf dist"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.1",
    "@floating-ui/react": "^0.27.20",
    "@hocuspocus/provider": "3.4.4",
    "@makeplane/propel": "0.9.7",
    "@plane/blocks": "workspace:*",
    "@plane/constants": "workspace:*",
    "@plane/hooks": "workspace:*",
    "@plane/types": "workspace:*",
    "@plane/utils": "workspace:*",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-blockquote": "3.31.3",
    "@tiptap/extension-collaboration": "3.31.3",
    "@tiptap/extension-document": "3.31.3",
    "@tiptap/extension-emoji": "3.31.3",
    "@tiptap/extension-heading": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-list-item": "3.31.3",
    "@tiptap/extension-mention": "3.31.3",
    "@tiptap/extension-task-item": "3.31.3",
    "@tiptap/extension-task-list": "3.31.3",
    "@tiptap/extension-text": "3.31.3",
    "@tiptap/extension-text-align": "3.31.3",
    "@tiptap/extension-text-style": "3.31.3",
    "@tiptap/extension-underline": "3.31.3",
    "@tiptap/extensions": "3.31.3",
    "@tiptap/html": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@tiptap/suggestion": "3.31.3",
    "@tiptap/y-tiptap": "3.0.9",
    "buffer": "^6.0.3",
    "emoji-regex": "^10.3.0",
    "happy-dom": "21.0.4",
    "highlight.js": "^11.8.0",
    "is-emoji-supported": "^0.0.5",
    "jsx-dom-cjs": "^8.0.3",
    "linkifyjs": "^4.3.3",
    "lodash-es": "4.18.1",
    "lowlight": "^3.0.0",
    "prosemirror-codemark": "^0.4.2",
    "prosemirror-markdown": "1.13.4",
    "tiptap-markdown": "0.9.0",
    "uuid": "14.0.0",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.20"
  },
  "devDependencies": {
    "@plane/tailwind-config": "workspace:*",
    "@plane/typescript-config": "workspace:*",
    "@types/lodash-es": "4.17.12",
    "@types/node": "22.12.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "postcss": "8.5.25",
    "tsdown": "0.16.0",
    "typescript": "5.8.3",
    "vitest": "^4.1.12"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
